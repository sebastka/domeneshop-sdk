{
    "name": "sebastka/domeneshop-dashboard",
    "description": "Read-only access to Domeneshop dashboard functions that the API does not expose. Unofficial and unsupported.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "domeneshop",
        "dns",
        "dnssec",
        "nameservers"
    ],
    "homepage": "https://github.com/sebastka/domeneshop-dashboard",
    "authors": [
        {
            "name": "Sebastian Karlsen",
            "email": "sebastian@karlsen.fr"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../domeneshop-cli*"
        },
        {
            "type": "path",
            "url": "../domeneshop-php*"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.10 || ^8.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "sebastka/domeneshop-cli": "^0.3",
        "symfony/console": "^7.0 || ^8.0"
    },
    "suggest": {
        "sebastka/domeneshop-cli": "Adds the dashboard:* commands to the `domeneshop` CLI."
    },
    "autoload": {
        "psr-4": {
            "Sebastka\\Domeneshop\\Dashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sebastka\\Domeneshop\\Dashboard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.3.x-dev",
            "dev-main": "0.3.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
